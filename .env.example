# ── Admin-Login ───────────────────────────────────────────────────────────────
# Beides auf einmal erzeugen mit:
#   npm run hash-password -- 'MeinPasswort'
# Der Hash wird Base64-kodiert ausgegeben: ohne Anführungszeichen, ohne
# Escaping einsetzen - genau so, wie das Skript ihn ausgibt, hier und in Vercel.
# (Ein roher bcrypt-Hash "$2a$12$..." funktioniert hier NICHT: Next.js schickt
#  .env-Werte durch dotenv-expand, das "$2a" als Variable liest und leert.)
ADMIN_PASSWORD_HASH=
# Zufälliger Schlüssel zum Signieren der Session (min. 32 Zeichen):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Bildspeicher (Vercel Blob) ────────────────────────────────────────────────
# Wird von Vercel automatisch gesetzt, sobald ein Blob-Store verbunden ist.
# Fehlt die Variable, speichert die App lokal unter public/uploads (nur für Dev).
BLOB_READ_WRITE_TOKEN=

# ── Google-Bewertungen (Places API New) ───────────────────────────────────────
# Google Cloud Console -> Places API (New) aktivieren -> API-Key erstellen
# -> Key auf "Places API (New)" + Server-IP beschränken.
GOOGLE_PLACES_API_KEY=
# Place ID des Eintrags. Einmalig ermitteln mit: npm run find-place-id
GOOGLE_PLACE_ID=

# ── Kontaktformular ───────────────────────────────────────────────────────────
# PFLICHT fuer den Livegang. Ohne Key wird die Anfrage nur ins Log geschrieben
# und das Formular sagt dem Besucher ehrlich, dass der Versand nicht steht.
# resend.com -> Domain sunna-photovoltaik.de verifizieren (DNS-Eintraege),
# danach unter API Keys einen Key mit Sende-Recht erzeugen.
RESEND_API_KEY=
# Empfaenger. Leer lassen = Adresse aus src/lib/site.ts (info@sunna-photovoltaik.de).
# Nur setzen, wenn Anfragen bewusst woanders landen sollen (z. B. Test-Postfach).
CONTACT_TO_EMAIL=
# Absender. Muss auf der in Resend VERIFIZIERTEN Domain liegen - nicht die
# Adresse des Besuchers (sonst blocken SPF/DKIM/DMARC die Zustellung).
# Leer lassen = website@sunna-photovoltaik.de.
CONTACT_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=https://www.sunna-photovoltaik.de
